{
  "name": "yep-anywhere",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:core": "pnpm --filter yep-anywhere --filter @yep-anywhere/server... --filter @yep-anywhere/client... install",
    "setup-vapid": "tsx scripts/setup-vapid.ts",
    "clone-references": "node scripts/clone-references.mjs --sync",
    "references:sync": "node scripts/clone-references.mjs --sync",
    "references:check": "node scripts/clone-references.mjs --check",
    "codex:protocol:update": "node scripts/update-codex-protocol.mjs",
    "codex:protocol:check": "node scripts/update-codex-protocol.mjs --check",
    "codex:user-turns:audit": "tsx scripts/audit-codex-user-turn-provenance.ts",
    "i18n:check": "node scripts/prune-i18n-placeholders.mjs --check",
    "i18n:health": "node scripts/prune-i18n-placeholders.mjs --health",
    "i18n:missing": "node scripts/report-i18n-missing.mjs",
    "i18n:prune": "node scripts/prune-i18n-placeholders.mjs --write",
    "i18n:scan": "node scripts/find-raw-i18n-copy.mjs",
    "agent:monitor": "node scripts/monitor-agent-process.mjs",
    "android:interop:check": "tsx --conditions source scripts/android-secure-interop-fixture.ts",
    "android:interop:write": "tsx scripts/android-secure-interop-fixture.ts --write",
    "android:probe-server": "pnpm --filter @yep-anywhere/server exec tsx --conditions source scripts/android-native-secure-probe-server.ts",
    "css:check": "node scripts/check-css-architecture.mjs",
    "css:health": "tsx scripts/css-health.ts",
    "css:inventory": "tsx scripts/css-inventory.ts",
    "css:modules:check": "tsx scripts/find-unused-css.ts --modules-check",
    "css:touched": "tsx scripts/report-touched-css.ts",
    "css:unused": "tsx scripts/find-unused-css.ts",
    "capabilities:audit": "tsx scripts/audit-server-capabilities.ts",
    "console:scan": "node scripts/find-console-chatter.mjs",
    "console:volume": "node scripts/report-client-log-volume.mjs",
    "managed-runner:build": "node scripts/build-managed-runner.mjs",
    "managed-ssh:probe": "tsx --conditions source scripts/probe-managed-ssh-gate-b.ts",
    "managed-ssh:codex-probe": "tsx --conditions source scripts/probe-managed-ssh-gate-c.ts",
    "perf:regression:server": "node scripts/perf-suite/run.mjs --checkout . --scenario fleet-small --driver server --label working-tree",
    "perf:regression:browser": "node scripts/perf-suite/run.mjs --checkout . --scenario fleet-small --driver browser --label working-tree",
    "perf:regression:specialized": "node scripts/perf-suite/run.mjs --checkout . --scenario specialized-contracts --driver specialized --label working-tree",
    "dev": "node scripts/dev.js",
    "provider-host": "node scripts/provider-runtime-host.mjs --headless",
    "staging": "node scripts/staging.js",
    "dev:auto": "pnpm --filter server dev & pnpm --filter client dev",
    "dev-tailscale": "tailscale serve --bg 3400 && pnpm dev",
    "start": "NODE_ENV=production node packages/server/dist/index.js",
    "build": "pnpm -r build",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "build:stable": "pnpm --filter client build:stable",
    "typecheck": "pnpm --filter shared build && pnpm -r --filter=!@yep-anywhere/android exec tsc --noEmit",
    "test": "pnpm -r --filter=!@yep-anywhere/android test",
    "test:e2e": "pnpm --filter client test:e2e",
    "test:e2e:ui": "pnpm --filter client test:e2e",
    "test:e2e:android": "pnpm --filter client test:e2e:android",
    "test:e2e:android:soak": "pnpm --filter client test:e2e:android:soak",
    "test:e2e:emulator:apk": "pnpm --filter client test:e2e:emulator:apk",
    "test:e2e:emulator:apk:adaptive": "pnpm --filter client test:e2e:emulator:apk:adaptive",
    "test:e2e:chromeos": "pnpm --filter client test:e2e:chromeos",
    "test:e2e:sdk": "pnpm --filter server test:e2e",
    "test:e2e:sdk:real": "pnpm --filter server test:e2e:real",
    "test:e2e:sdk:local": "pnpm --filter server test:e2e:local",
    "test:e2e:sdk:local:quality": "pnpm --filter server test:e2e:local:quality",
    "lint": "node scripts/check-css-architecture.mjs && pnpm css:modules:check && node scripts/biome.cjs lint .",
    "format": "node scripts/biome.cjs format --write .",
    "format:check": "node scripts/biome.cjs format .",
    "prepare": "husky",
    "site:dev": "node scripts/run-site-npm.mjs dev",
    "site:build": "node scripts/run-site-npm.mjs build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "esbuild": "0.27.2",
    "husky": "^9.1.7",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.12"
  },
  "yepAnywhere": {
    "codexCli": {
      "expectedVersion": "0.153.3",
      "compatibleThroughVersion": "0.153.4"
    },
    "claudeCode": {
      "compatibleThroughVersion": "2.1.258",
      "claudeAgentSdkVersion": "0.3.258"
    },
    "piCli": {
      "compatibleThroughVersion": "0.84.2"
    },
    "grokCli": {
      "compatibleThroughVersion": "1.0.4"
    }
  },
  "dependencies": {
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3"
  },
  "version": "0.7.0"
}
