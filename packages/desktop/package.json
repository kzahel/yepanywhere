{
  "name": "@yep-anywhere/desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare-server-resource": "node scripts/prepare-server-resource.mjs",
    "prepare-runtime": "pnpm prepare-sidecar && pnpm prepare-server-resource",
    "smoke-runtime": "node scripts/smoke-runtime.mjs",
    "test": "pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "dev": "node ../../scripts/run-with-safe-home.js vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri-ci": "node scripts/tauri-ci.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  }
}
