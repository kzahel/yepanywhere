{
  "name": "@yep-anywhere/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:markdown": "tsx --conditions source scripts/benchmark-safe-markdown.ts",
    "benchmark:codex-child-projection": "tsx --conditions source scripts/benchmark-codex-child-projection.ts",
    "benchmark:single-flight": "tsx --conditions source scripts/benchmark-source-versioned-single-flight.ts",
    "benchmark:provider-watch-startup": "tsx --conditions source scripts/benchmark-provider-watch-startup.ts",
    "benchmark:session-catalog": "tsx --conditions source scripts/benchmark-session-catalog.ts",
    "benchmark:heartbeat-candidates": "tsx --conditions source scripts/benchmark-heartbeat-candidates.ts",
    "benchmark:heartbeat-schedule": "tsx --conditions source scripts/benchmark-heartbeat-schedule.ts",
    "benchmark:provider-catalog-adapters": "tsx --conditions source scripts/benchmark-provider-catalog-adapters.ts",
    "benchmark:provider-model-route": "tsx --conditions source scripts/benchmark-provider-model-route.ts",
    "benchmark:review-inbox": "tsx --conditions source scripts/benchmark-review-inbox.ts",
    "benchmark:relay-json": "tsx --conditions source scripts/benchmark-relay-json.ts",
    "benchmark:version-route": "tsx --conditions source scripts/benchmark-version-route.ts",
    "benchmark:session-collection-generation": "tsx --conditions source scripts/benchmark-session-collection-generation.ts",
    "benchmark:inbox-collection-walk": "tsx --conditions source scripts/benchmark-inbox-collection-walk.ts",
    "dev": "node ../../scripts/run-with-safe-home.js tsx --conditions source src/index.ts",
    "dev:watch": "node ../../scripts/run-with-safe-home.js tsx watch --conditions source src/index.ts",
    "dev:mock": "AUTH_DISABLED=true node ../../scripts/run-with-safe-home.js tsx --conditions source src/index.ts",
    "build": "tsc && node ../../scripts/copy-server-assets.mjs",
    "test": "node ../../scripts/run-with-safe-home.js --temporary-home vitest run",
    "test:e2e": "node ../../scripts/run-with-safe-home.js vitest run test/e2e",
    "test:e2e:real": "REAL_SDK_TESTS=true node ../../scripts/run-with-safe-home.js vitest run test/e2e",
    "test:e2e:real:fg": "REAL_SDK_TESTS=true FOREGROUND=1 node ../../scripts/run-with-safe-home.js vitest run test/e2e"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.12.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "0.100.1",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.2.0",
    "@mdit/plugin-katex": "1.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@yep-anywhere/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "diff": "^8.0.3",
    "hono": "^4.13.5",
    "http-proxy": "^1.18.1",
    "katex": "^0.18.6",
    "markdown-it": "15.0.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "proper-lockfile": "^4.1.2",
    "sanitize-html": "^2.17.7",
    "shiki": "^3.20.0",
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/diff": "^8.0.0",
    "@types/http-proxy": "^1.17.17",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
