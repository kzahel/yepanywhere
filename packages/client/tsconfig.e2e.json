{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"]
  },
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.mjs",
    "playwright*.config.ts",
    "scripts/design-*.ts",
    "src/vite-env.d.ts",
    "src/lib/routeRetention.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
