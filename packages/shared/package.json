{
  "name": "@yep-anywhere/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/find/frameFindAgent.ts",
    "./dist/find/frameFindAgent.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server-runtime": {
      "source": "./src/server-runtime.ts",
      "import": "./dist/server-runtime.js",
      "types": "./dist/server-runtime.d.ts"
    },
    "./agent-api-bootstrap": {
      "source": "./src/agent-api-bootstrap.ts",
      "import": "./dist/agent-api-bootstrap.js",
      "types": "./dist/agent-api-bootstrap.d.ts"
    },
    "./sqlite": {
      "source": "./src/sqlite.ts",
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    },
    "./transcript/*": {
      "source": "./src/transcript/*.ts",
      "import": "./dist/transcript/*.js",
      "types": "./dist/transcript/*.d.ts"
    },
    "./find/*": {
      "source": "./src/find/*.ts",
      "import": "./dist/find/*.js",
      "types": "./dist/find/*.d.ts"
    },
    "./experimental/*": {
      "source": "./src/experimental/*.ts",
      "import": "./dist/experimental/*.js",
      "types": "./dist/experimental/*.d.ts"
    },
    "./collection-updates": {
      "source": "./src/collection-updates.ts",
      "import": "./dist/collection-updates.js",
      "types": "./dist/collection-updates.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node ../../scripts/run-with-safe-home.js vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  }
}
