{
  "name": "@yep-anywhere/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server-runtime": {
      "source": "./src/server-runtime.ts",
      "import": "./dist/server-runtime.js",
      "types": "./dist/server-runtime.d.ts"
    },
    "./sqlite": {
      "source": "./src/sqlite.ts",
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    },
    "./transcript/*": {
      "source": "./src/transcript/*.ts",
      "import": "./dist/transcript/*.js",
      "types": "./dist/transcript/*.d.ts"
    },
    "./experimental/*": {
      "source": "./src/experimental/*.ts",
      "import": "./dist/experimental/*.js",
      "types": "./dist/experimental/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node ../../scripts/run-with-safe-home.js vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.4"
  }
}
