---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { features, providers } from "../data/catalog";
import type { PublicFeature } from "../data/features";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredFeatures = (features as readonly PublicFeature[]).filter(
  (feature) => feature.featured,
);
const formatProviderNames = (names: readonly string[]) => {
  if (names.length < 3) return names.join(" and ");
  return `${names.slice(0, -1).join(", ")}, and ${names.at(-1)}`;
};
const stableProviderNames = formatProviderNames(
  providers
    .filter((provider) => provider.status === "stable")
    .map((provider) => provider.name),
);
const experimentalProviderNames = formatProviderNames(
  providers
    .filter((provider) => provider.status === "experimental")
    .map((provider) => provider.name),
);
---

<BaseLayout
  title="Yep Anywhere — All your coding agents on every device"
  description="Access Claude Code and Codex on your machines from any browser while using your existing Claude or ChatGPT subscription plan."
>
  <Header activePage="home" />

  <div class="announcement">
    <div class="site-container announcement-content">
      <span>Beta</span>
      <p>Signed desktop apps for macOS and Windows are available in beta.</p>
      <a href="/docs/desktop-apps">See what is ready <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <main>
    <section class="hero">
      <div class="site-container hero-copy">
        <p class="eyebrow">The full agent workspace, everywhere</p>
        <h1>All your agents.<br><span>Every device.</span></h1>
        <p class="lede">Access all your Claude Code and Codex agents from any browser—on any computer, tablet, or phone—with the full workflow intact.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-secondary" href="/features">Explore features</a>
          <a class="text-link" href="/remote">Log in to your server <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">Use your existing Claude or ChatGPT subscription</p>
      </div>

      <div class="site-container product-stage" aria-label="Yep Anywhere on desktop and mobile">
        <figure class="desktop-frame">
          <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>localhost:3400</span></div>
          <img src="/screenshots/desktop.png" alt="Yep Anywhere showing several coding agent sessions on desktop">
        </figure>
        <figure class="phone-frame phone-primary">
          <span class="phone-speaker" aria-hidden="true"></span>
          <img src="/screenshots/mobile-approve-edit.png" alt="Approving a coding agent file edit from a phone">
        </figure>
        <figure class="phone-frame phone-secondary">
          <span class="phone-speaker" aria-hidden="true"></span>
          <img src="/screenshots/mobile-completed-session.png" alt="Reviewing a completed coding session from a phone">
        </figure>
      </div>
    </section>

    <section class="proof-strip" aria-label="Product highlights">
      <div class="site-container">
        <p><strong>Use existing subscriptions</strong><span>Claude + ChatGPT plans</span></p>
        <p><strong>No network setup</strong><span>Install, set a password, open anywhere</span></p>
        <p><strong>Uses the official tools</strong><span>Claude Code + Codex run on your host</span></p>
        <p><strong>Private by architecture</strong><span>Direct connection or end-to-end encrypted relay</span></p>
      </div>
    </section>

    <section class="promise-section" id="why-yep-anywhere">
      <div class="site-container">
        <header class="section-heading centered">
          <p class="eyebrow">Not just another remote control</p>
          <h2>Why Yep Anywhere?</h2>
          <p>We surveyed the remote-agent landscape. Plenty of projects forward an agent chat to another screen. We did not find another that combines this much agent control with every-device access, local data ownership, direct connections, and an end-to-end encrypted relay.</p>
        </header>

        <div class="promise-grid">
          <article>
            <h3>Full detail, without the noise</h3>
            <p>The complete session transcript, every tool call, and available thinking stay within reach. Switch to Conversation view or collapse routine activity whenever you want a calmer, less verbose read.</p>
          </article>
          <article>
            <h3>Every browser—not only your phone</h3>
            <p>Claude Code and ChatGPT now offer useful first-party remote experiences. Yep Anywhere gives the complete multi-provider workspace to anything with a modern web browser, across all your connected hosts.</p>
          </article>
          <article>
            <h3>Private by architecture</h3>
            <p>Agents, credentials, and history stay on your machines. Connect directly, self-host the infrastructure, or use end-to-end encrypted relay traffic the relay cannot read. Public shares are separate and opt-in.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="catalog-preview">
      <div class="site-container">
        <header class="section-heading split">
          <div>
            <p class="eyebrow">Built for real agent workflows</p>
            <h2>More than a remote terminal.</h2>
          </div>
          <p>Coordinate sessions, steer active work, inspect changes, and control how each machine is exposed.</p>
        </header>

        <div class="feature-grid">
          {featuredFeatures.map((feature, index) => (
            <article class:list={["feature-card", { spotlight: index === 0 }]}>
              <h3>{feature.title}</h3>
              <p>{feature.summary}</p>
              <a href={feature.docsPath}>Read the guide <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>

        <p class="catalog-link"><a class="btn btn-secondary" href="/features">See the complete feature catalog</a></p>
      </div>
    </section>

    <section class="workflow-section">
      <div class="site-container workflow-grid">
        <div class="workflow-copy">
          <p class="eyebrow">Remote without surrendering control</p>
          <h2>Your machine stays the source of truth.</h2>
          <p>For the easiest path, enable the free end-to-end encrypted public relay, set a password, and open Yep Anywhere from any browser. No device pairing, VPN, or port forwarding. Your provider credentials and session history remain on the host.</p>
          <ul>
            <li><strong>No device pairing.</strong> Sign in from any modern web browser.</li>
            <li><strong>No hosted product account.</strong> Authenticate to the server you control.</li>
            <li><strong>No provider proxy.</strong> Agents run against your locally configured CLIs.</li>
            <li><strong>No lock-in.</strong> The app and relay are open source under MIT.</li>
          </ul>
          <a class="text-link" href="/docs/remote-access">Compare connection options <span aria-hidden="true">→</span></a>
        </div>
        <figure class="workflow-shot">
          <img src="/screenshots/desktop-remote-access.png" alt="Remote access settings in Yep Anywhere">
          <figcaption>Choose the access model that fits each host.</figcaption>
        </figure>
      </div>

      <div class="site-container security-practice" id="security-practice">
        <header class="section-heading centered">
          <p class="eyebrow">Security is ongoing work</p>
          <h2>Small surface. Accountable maintainers.</h2>
          <p>Security comes from understandable architecture and continued review—not a blanket promise.</p>
        </header>

        <div class="promise-grid">
          <article>
            <h3>Narrow dependency surface</h3>
            <p>The runtime dependency surface is kept deliberately narrow. New dependencies must justify their long-term update, payload, and audit cost; security and cryptography use established implementations.</p>
          </article>
          <article>
            <h3>Regular maintainer-led audits</h3>
            <p>Authentication, relay boundaries, content rendering, local file access, dependencies, and provider integrations are repeatedly reviewed as the product changes. <a href="/docs/security-and-privacy">Read the security guide</a>.</p>
          </article>
          <article>
            <h3>Two core maintainers</h3>
            <p>The people responsible for the project are public and the core maintainer set is intentionally small.</p>
            <ul class="maintainer-list">
              <li>
                <strong>Jonathan Graehl <span>@graehl</span></strong>
                <span><a href="https://github.com/graehl">GitHub</a> · <a href="https://graehl.org">Website</a></span>
              </li>
              <li>
                <strong>Kyle Graehl <span>@kzahel</span></strong>
                <span><a href="https://github.com/kzahel">GitHub</a> · <a href="https://www.linkedin.com/in/kylegraehl">LinkedIn</a></span>
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="install-section">
      <div class="site-container">
        <header class="section-heading centered">
          <p class="eyebrow">Choose your starting point</p>
          <h2>Install it where your agents run.</h2>
          <p>Desktop packaging is nearing release readiness. The npm install remains the established path for full configuration access.</p>
        </header>

        <div class="install-grid">
          <article class="install-card desktop-card">
            <div class="install-label"><span>Desktop apps</span><em>Beta</em></div>
            <h3>macOS and Windows</h3>
            <p>Signed installers bundle the server and web client for a guided local setup.</p>
            <div class="platform-list">
              <a href="/download">Download desktop app <span aria-hidden="true">→</span></a>
            </div>
            <a class="text-link" href="/docs/desktop-apps">Desktop installation guide <span aria-hidden="true">→</span></a>
          </article>

          <article class="install-card terminal-card">
            <div class="install-label"><span>Command line</span><em class="stable">Available</em></div>
            <h3>npm on macOS, Windows, and Linux</h3>
            <div class="command-block" aria-label="Installation commands">
              <code><span>$</span> npm i -g yepanywhere</code>
              <code><span>$</span> yepanywhere</code>
            </div>
            <a class="text-link" href="/docs/install-npm">npm installation guide <span aria-hidden="true">→</span></a>
          </article>
        </div>

        <aside class="mobile-status">
          <h3>Why no native mobile apps yet?</h3>
          <p>The responsive browser already provides the complete Yep Anywhere workflow on phones and tablets: approvals, diffs, uploads, voice input, and notifications.</p>
          <p>We do not want to publish thin app-store wrappers. The Android app is in development around native advantages such as more reliable background notifications, deep links, trusted packaged client code, and a multi-server inbox; iOS is planned afterward. Neither app is published. Until the native value is release-ready, the browser is the supported mobile experience.</p>
        </aside>
      </div>
    </section>

    <section class="faq-section">
      <div class="site-container faq-grid">
        <header>
          <p class="eyebrow">The practical difference</p>
          <h2>Why not use the first-party remote apps?</h2>
          <a href="/docs">Browse all documentation <span aria-hidden="true">→</span></a>
        </header>
        <div class="questions">
          <details open>
            <summary>What does Yep Anywhere add?</summary>
            <p>Claude Code Remote Control and Codex in the ChatGPT mobile app are useful first-party options. Yep Anywhere puts Claude Code and Codex together in one complete browser workspace across all your connected hosts. You are not limited to one provider or a phone app.</p>
          </details>
          <details>
            <summary>Which coding agents work?</summary>
            <p>{stableProviderNames} are first-class providers. {experimentalProviderNames} integrations are experimental.</p>
          </details>
          <details>
            <summary>Does the browser have to stay open?</summary>
            <p>No. The server owns agent processes, so active work continues across browser disconnects. The host machine does need to stay running.</p>
          </details>
          <details>
            <summary>Is there a hosted version?</summary>
            <p>No hosted Yep Anywhere workspace or product account is required. Run the server yourself, then connect directly or through the optional relay.</p>
          </details>
          <details>
            <summary>Is there a mobile app?</summary>
            <p>Not yet. The full product works in a mobile browser today. Android is in development and iOS is planned afterward; neither app is published.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="site-container cta-panel">
        <div>
          <p class="eyebrow">One install. Every screen.</p>
          <h2>Give your agents room to run.</h2>
          <p>Start locally in minutes, then decide how—and where—you want to reconnect.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-secondary" href="https://github.com/kzahel/yepanywhere">View on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .announcement {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-primary));
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
  }

  .announcement-content {
    align-items: center;
    display: flex;
    font-size: 13px;
    gap: 12px;
    justify-content: center;
    min-height: 42px;
  }

  .announcement-content > span {
    background: var(--accent);
    border-radius: 999px;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    text-transform: uppercase;
  }

  .announcement-content a,
  .text-link,
  .faq-grid header a {
    color: var(--accent-hover);
    font-weight: 650;
    text-decoration: none;
  }

  .hero {
    overflow: hidden;
    padding: 94px 0 110px;
  }

  .hero-copy {
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(46px, 6vw, 76px);
    letter-spacing: -0.055em;
    line-height: 0.96;
    margin: 24px auto 0;
    max-width: 880px;
  }

  .hero h1 span {
    color: var(--text-secondary);
  }

  .lede {
    color: var(--text-secondary);
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.55;
    margin: 30px auto 0;
    max-width: 780px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    justify-content: center;
    margin-top: 34px;
  }

  .hero-actions .text-link {
    margin-left: 8px;
  }

  .hero-note {
    color: var(--text-secondary);
    font-size: 12px;
    letter-spacing: 0.025em;
    margin-top: 20px;
  }

  .product-stage {
    margin-top: 72px;
    min-height: 550px;
    position: relative;
  }

  .desktop-frame {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 35px 100px #0008;
    margin: 0 auto;
    max-width: 1010px;
    overflow: hidden;
  }

  .window-bar {
    align-items: center;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
  }

  .window-bar i {
    background: var(--text-secondary);
    border-radius: 50%;
    height: 8px;
    opacity: 0.45;
    width: 8px;
  }

  .window-bar span {
    color: var(--text-secondary);
    font-family: monospace;
    font-size: 10px;
    margin-left: auto;
    margin-right: auto;
  }

  .desktop-frame img,
  .phone-frame img,
  .workflow-shot img {
    display: block;
    height: auto;
    width: 100%;
  }

  .phone-frame {
    background: #080808;
    border: 5px solid #0a0a0a;
    border-radius: 28px;
    box-shadow: 0 25px 70px #000a;
    overflow: hidden;
    position: absolute;
    width: min(225px, 21vw);
  }

  .phone-primary {
    bottom: -18px;
    left: 0;
    transform: rotate(-3deg);
  }

  .phone-secondary {
    bottom: -46px;
    right: 0;
    transform: rotate(3deg);
  }

  .phone-speaker {
    background: #272727;
    border-radius: 99px;
    height: 5px;
    left: 41%;
    position: absolute;
    top: 8px;
    width: 18%;
    z-index: 2;
  }

  .proof-strip {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }

  .proof-strip .site-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .proof-strip p {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
  }

  .proof-strip p + p {
    border-left: 1px solid var(--border);
  }

  .proof-strip strong {
    font-size: 14px;
  }

  .proof-strip span {
    color: var(--text-secondary);
    font-size: 12px;
  }

  .promise-section,
  .catalog-preview,
  .workflow-section,
  .install-section,
  .faq-section,
  .final-cta {
    padding: 112px 0;
  }

  .catalog-preview,
  .install-section {
    background: var(--bg-secondary);
  }

  .section-heading h2,
  .workflow-copy h2,
  .faq-grid h2,
  .cta-panel h2 {
    font-size: clamp(36px, 5vw, 58px);
    letter-spacing: -0.045em;
    line-height: 1.03;
    margin-top: 13px;
  }

  .section-heading > p,
  .split > p,
  .workflow-copy > p,
  .cta-panel > div > p:last-child {
    color: var(--text-secondary);
    font-size: 17px;
  }

  .section-heading.centered {
    margin: 0 auto 52px;
    max-width: 820px;
    text-align: center;
  }

  .section-heading.centered > p:last-child {
    margin: 20px auto 0;
    max-width: 670px;
  }

  .section-heading.split {
    align-items: end;
    display: grid;
    gap: 60px;
    grid-template-columns: 1.3fr 0.7fr;
    margin-bottom: 52px;
  }

  .promise-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, 1fr);
  }

  .promise-grid article {
    border: 1px solid var(--border);
    border-radius: 14px;
    min-height: 270px;
    padding: 28px;
  }

  .promise-grid h3,
  .feature-card h3,
  .install-card h3 {
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-top: 0;
  }

  .promise-grid p,
  .feature-card p,
  .install-card > p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 13px;
  }

  .feature-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
  }

  .feature-card {
    background: var(--bg-primary);
    min-height: 286px;
    padding: 30px;
    position: relative;
  }

  .feature-card.spotlight {
    grid-column: span 2;
  }

  .feature-card a {
    bottom: 28px;
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 650;
    position: absolute;
    text-decoration: none;
  }

  .catalog-link {
    margin-top: 30px;
    text-align: center;
  }

  .workflow-grid {
    align-items: center;
    display: grid;
    gap: 70px;
    grid-template-columns: 0.82fr 1.18fr;
  }

  .workflow-copy > p {
    margin-top: 22px;
  }

  .workflow-copy ul {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 30px 0;
  }

  .workflow-copy li {
    color: var(--text-secondary);
    font-size: 14px;
    padding-left: 22px;
    position: relative;
  }

  .workflow-copy li::before {
    color: var(--accent);
    content: "✓";
    left: 0;
    position: absolute;
  }

  .workflow-copy strong {
    color: var(--text-primary);
  }

  .security-practice {
    border-top: 1px solid var(--border);
    margin-top: 90px;
    padding-top: 90px;
  }

  .security-practice a,
  .maintainer-list a {
    color: var(--accent-hover);
    font-weight: 650;
    text-decoration: none;
  }

  .maintainer-list {
    display: grid;
    gap: 12px;
    list-style: none;
    margin-top: 18px;
  }

  .maintainer-list li,
  .maintainer-list strong {
    display: flex;
    flex-direction: column;
  }

  .maintainer-list li > span,
  .maintainer-list strong span {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
  }

  .workflow-shot {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 25px 70px #0007;
    overflow: hidden;
  }

  .workflow-shot figcaption {
    color: var(--text-secondary);
    font-size: 12px;
    padding: 12px 16px;
  }

  .install-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr 1fr;
  }

  .install-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    min-height: 375px;
    padding: 30px;
  }

  .install-label {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .install-label > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-label em {
    background: #d977061c;
    border: 1px solid #d9770655;
    border-radius: 99px;
    color: #f59e0b;
    font-size: 10px;
    font-style: normal;
    padding: 3px 8px;
  }

  .install-label em.stable {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 42%, transparent);
    color: var(--accent-hover);
  }

  .install-card h3 {
    font-size: 25px;
    margin-top: 48px;
  }

  .install-card .text-link {
    margin-top: auto;
  }

  .platform-list {
    display: flex;
    gap: 10px;
    margin: 28px 0;
  }

  .platform-list a {
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 7px;
    color: white;
    font-size: 14px;
    font-weight: 650;
    padding: 11px 16px;
    text-decoration: none;
  }

  .platform-list a:hover {
    background: var(--accent-hover);
  }

  .command-block {
    background: #080808;
    border: 1px solid #292929;
    border-radius: 9px;
    display: grid;
    gap: 8px;
    margin: 26px 0;
    padding: 18px;
  }

  .command-block code {
    color: #e5e5e5;
    font-size: 13px;
  }

  .command-block span {
    color: #22c55e;
  }

  .mobile-status {
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    margin: 48px auto 0;
    max-width: 820px;
    padding-top: 30px;
    text-align: center;
  }

  .mobile-status h3 {
    color: var(--text-primary);
    font-size: 21px;
  }

  .mobile-status p {
    font-size: 14px;
    margin-top: 12px;
  }

  .faq-grid {
    display: grid;
    gap: 90px;
    grid-template-columns: 0.72fr 1.28fr;
  }

  .faq-grid header a {
    display: inline-block;
    margin-top: 25px;
  }

  .questions details {
    border-top: 1px solid var(--border);
    padding: 24px 0;
  }

  .questions details:last-child {
    border-bottom: 1px solid var(--border);
  }

  .questions summary {
    cursor: pointer;
    font-size: 17px;
    font-weight: 650;
  }

  .questions p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 13px;
    max-width: 650px;
  }

  .final-cta {
    padding-top: 0;
  }

  .cta-panel {
