{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-*",
      "!**/*.d.ts",
      "!**/.artifacts",
      "!**/.tmp",
      "!**/.git-blame-ignore-revs",
      "!**/.handoff-recap.md",
      "!**/*.running.md",
      "!**/tasks",
      "!**/docs/tasks",
      "!**/branding",
      "!**/packages/desktop",
      "!**/packages/server/generated/codex-app-server",
      "!**/packages/server/src/sdk/providers/codex-protocol/generated"
    ]
  },
  "overrides": [
    {
      "includes": [
        "packages/shared/src/claude-sdk-schema/index.ts",
        "packages/shared/src/codex-schema/index.ts",
        "packages/shared/src/gemini-schema/index.ts",
        "packages/shared/src/opencode-schema/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/device-bridge/cmd/bridge/web/**/*.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/server/test/fixtures/**/*.html"],
      "linter": {
        "rules": {
          "a11y": {
            "noAmbiguousAnchorText": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/client/src/**",
        "!packages/client/src/**/*.specimen.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/*.specimen",
                      "**/*.specimen.tsx",
                      "**/design/**",
                      "virtual:ya-design-data"
                    ],
                    "message": "The design playground and its example files are dev-only; production client code must not import them (topics/ui-design.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/client/src/**/*.module.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "error"
          },
          "nursery": {
            "noExcessiveSelectorClasses": {
              "level": "error",
              "options": { "maxClasses": 4 }
            }
          },
          "style": {
            "noDescendingSpecificity": "error",
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": { "maxLines": 600 }
            },
            "noValueAtRule": "error"
          },
          "suspicious": {
            "noDuplicateProperties": "error"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noDuplicateProperties": "off",
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "warn",
        "useExhaustiveDependencies": {
          "level": "warn",
          "options": {
            "hooks": [
              {
                "name": "useSessionCorrectionDraft",
                "stableResult": ["setCorrectionDraft"]
              },
              {
                "name": "useSessionComposerAttachments",
                "stableResult": [
                  "attachmentsRef",
                  "draftAttachmentBatchIdRef",
                  "draftAttachmentHydrationRef",
                  "setUploadProgress",
                  "pendingUploadsRef"
                ]
              },
              {
                "name": "useComposerSpeechState",
                "stableResult": [
                  "speechState",
                  "setInterimTranscript",
                  "interimTranscriptRef",
                  "setSpeechPending",
                  "speechPendingRef",
                  "speechTransactionHasTextRef",
                  "setSpeechPreviewRevision",
                  "speechTurnIdRef",
                  "speechInsertionRangeRef",
                  "activeSpeechTargetIdRef",
                  "speechInsertionRangesRef",
                  "pendingSpeechRetargetRef",
                  "pendingSpeechFinalRef",
                  "composerEditedDuringSpeechRef",
                  "pendingTextareaSelectionRef",
                  "clearPendingSpeechFinal",
                  "noteSpeechDraftEdit",
                  "noteSpeechDraftReplacement",
                  "restorePendingTextareaSelection"
                ]
              }
            ]
          }
        }
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "warn",
          "options": {
            "inputComponents": [
              "TextInput",
              "Textarea",
              "Select",
              "Checkbox",
              "Radio"
            ]
          }
        },
        "noStaticElementInteractions": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useHtmlLang": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
